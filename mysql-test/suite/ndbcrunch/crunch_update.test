# Run crunch update
#
--source sb_init.inc

let $bench_name = $MYSQL_TEST_DIR/suite/ndbcrunch/cruncher.lua;

# Enable stats output
let $CRUNCH_STATS=1;

# 1. Prepare
let $bench_tables = 1;
let $bench_args = --stage=prepare --port=$MYSQLD1_PORT;
--source sb_run.inc

# 2. Capture Start Position
--connection default
let $binlog_start_file= query_get_value(SHOW BINARY LOG STATUS, File, 1);
let $binlog_start_pos= query_get_value(SHOW BINARY LOG STATUS, Position, 1);

# 3. Run Load (Updates)
let $bench_tables = 1;
let $bench_args = --stage=run --port=$MYSQLD1_PORT;
--source sb_run.inc

# 4. Capture End Position
--connection default
let $source_file= query_get_value(SHOW BINARY LOG STATUS, File, 1);
let $source_pos= query_get_value(SHOW BINARY LOG STATUS, Position, 1);

# 5. Replicate from Start to End
# replicate_mysqld2.inc uses $source_file/$source_pos as target (end)
# and now supports $binlog_start_file/$binlog_start_pos as start.
--source replicate_mysqld2.inc

# 6. Cleanup
--connection default
let $bench_tables = 1;
let $bench_args = --stage=cleanup --port=$MYSQLD1_PORT;
--source sb_run.inc
